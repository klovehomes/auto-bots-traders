{"devDependencies":{"concurrently":"^9.0.0","tsx":"^4.19.0","typescript":"^5.7.0"},"name":"fleet","private":true,"scripts":{"build":"npm run build --workspaces --if-present","dev":"concurrently -n api,engine,web \"npm run dev:api\" \"npm run dev:engine\" \"npm run dev:web\"","dev:api":"npm run dev --workspace @fleet/api","dev:engine":"npm run dev --workspace @fleet/engine","dev:web":"npm run dev --workspace @fleet/web","typecheck":"npm run typecheck --workspaces --if-present"},"type":"module","version":"0.1.0","workspaces":["packages/*"]}