# Copy this file to .env and fill in real values. Never commit a real .env.
# With no Alpaca keys set, the engine runs in stub mode (see README).

# ─────────────────────────────────────────────────────────────────────────
# MODE — the fleet-wide run mode. The fleet MODE is the ceiling: a bot
# file's own mode can hold that bot below it, never above it.
#
#   sim       = LOCAL FAKE DATA. The engine generates synthetic market
#               activity (seeded, so runs are reproducible); no broker,
#               no API keys needed. This is the mode for your laptop.
#   paper     = Alpaca PAPER account. Use once the paper API keys below
#               exist — simulated money, real market data. Phase 1:
#               Trendia trades for real on the paper account. Phase 3:
#               Vega runs his options pipeline (shadow mode by default,
#               see VEGA_SHADOW below). Phase 4: Snapback trades for real
#               on the paper account (hourly mean-reversion entries,
#               fast-tick exits); the remaining bots stay on the
#               simulator until their own phases land.
#   connected = LIVE accounts. VPS / production only, and only for bots
#               Keith has individually approved to go live. In this build
#               connected mode is a guardrail stub: it refuses to trade
#               live and runs the paper connection check only.
#
# Phase 5: MODE is only the INITIAL default. The dashboard's mode
# switch (upper right, under the status indicator) stores the chosen
# mode in MODE_STATE_PATH on the data volume, and the stored choice
# beats this env value on every later boot. The switch offers sim and
# paper; "Live cash account" is listed but locked — it cannot be
# selected until live trading is deliberately built per-bot.
# ─────────────────────────────────────────────────────────────────────────
MODE=sim

# Alpaca paper-trading API keys (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Shared secret between the engine and the API for POST /internal/events
INTERNAL_EVENT_TOKEN=dev-token

# Where the bot .md files live. Empty = default (../../bots relative to the repo layout).
# In Docker Compose this is set to /bots (mounted read-only from ../bots).
BOTS_DIR=

# API service
API_PORT=8080
# Where the engine posts events (Docker Compose overrides this to http://api:8080)
API_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────
# Public URLs — production (VPS) builds only. Leave both blank for
# local use; the dashboard then talks to the API on the same host,
# port 8080, exactly as it always has.
#
#   UI_URL  = the address the dashboard is served from, e.g.
#             https://traderbot.example.com
#             The API uses it as its CORS allowlist (only this origin
#             may call the API from a browser).
#   API_URL = the address browsers reach the API at, e.g.
#             https://api.traderbot.example.com
#             (or https://traderbot.example.com/api behind a reverse
#             proxy). Docker Compose passes it into the web image
#             build as Vite's VITE_API_URL and it is BAKED INTO the
#             static bundle — after changing it you must rebuild
#             (`docker compose up -d --build`); a restart keeps the
#             old address. The WebSocket URL is derived from API_URL
#             (https → wss, http → ws) with /events appended, so it
#             must be the API's public TLS address, never a bare
#             http:// URL on an https page (browsers block that as
#             mixed content).
# ─────────────────────────────────────────────────────────────────────────
UI_URL=
API_URL=

# Build version shown under the "Trader Bot Landscape" header. Blank =
# the checked-in default in packages/web/src/version.ts (bumped once per
# phase build). Set this to override the displayed version — e.g. a git
# short SHA for a local build. Like API_URL, Docker Compose passes it
# into the web build (as Vite's VITE_BUILD_VERSION) and it is baked into
# the bundle, so changing it needs a rebuild, not a restart.
BUILD_VERSION=

# Kill-switch (Risk Gate) control state file: per-bot halts + the audit
# log. Halts must persist across restarts, so point this at durable
# storage. Default: ./data/control-state.json relative to the API
# package. Docker Compose overrides it to /data/control-state.json on
# the fleet-data volume.
CONTROL_STATE_PATH=

# Phase 5 dashboard mode-switch state: the stored desired fleet mode
# (written by the API when Keith flips the dashboard switch; read by
# the engine at boot). Must persist across restarts. Default:
# data/mode-state.json relative to the API package. Docker Compose
# overrides it to /data/mode-state.json on the fleet-data volume.
MODE_STATE_PATH=

# Phase 6 event history: the API's durable record of the event
# stream (sequence-stamped at ingest; dashboards seed from it on
# load). Must persist across restarts. Default:
# data/event-history.json relative to the API package. Docker
# Compose overrides it to /data/event-history.json on the
# fleet-data volume.
EVENT_HISTORY_PATH=

# Phase 1 paper-trader state (Trendia's tracked entries, price peaks,
# pending orders, realized PnL, decision counter). Must persist across
# restarts so the runner reconciles with the broker. Default:
# data/paper-trendia-state.json relative to the engine package. Docker
# Compose overrides it to /data/paper-trendia-state.json.
PAPER_STATE_PATH=

# ─────────────────────────────────────────────────────────────────────────
# VEGA_SHADOW — Phase 3 (Vega) delivery mode. Default: true.
#
#   true  = SHADOW: Vega runs his full options pipeline on real data
#           (hourly screen, contract picks, Risk Gate verdicts) and
#           emits decision / order-intent events labelled SHADOW, but
#           places NO broker orders. This is the soak setting.
#   false = Vega places live PAPER orders on the Alpaca paper account.
#           Flip only on Keith's explicit word after the shadow soak.
# ─────────────────────────────────────────────────────────────────────────
VEGA_SHADOW=true

# Phase 3 Vega state (tracked contracts, pending orders, realized PnL,
# earnings-calendar map, daily IV history, decision counter). Default:
# data/paper-vega-state.json relative to the engine package. Docker
# Compose overrides it to /data/paper-vega-state.json.
VEGA_STATE_PATH=

# Phase 4 Snapback state (tracked positions, pending orders, realized
# PnL, last evaluation hour, decision counter). Default:
# data/paper-snapback-state.json relative to the engine package. Docker
# Compose overrides it to /data/paper-snapback-state.json.
SNAPBACK_STATE_PATH=
